
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
                     && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isCourier() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
                     && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'courier';
    }

    // --- Collection Rules ---

    // USERS
    match /users/{userId} {
      allow get: if isAuth();
      allow list: if isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // DELIVERIES
    match /deliveries/{deliveryId} {
      // A client can create a delivery for themselves.
      allow create: if isAuth() && request.resource.data.clientId == request.auth.uid;
      
      // An admin can perform any update.
      allow update: if isAdmin();
      
      // --- Courier Rules ---
      
      // 1. Courier: Accept a pending task (atribuir-se ao pedido)
      allow update: if isCourier()
                    && resource.data.status == 'pending'
                    && (request.resource.data.status == 'accepted' || request.resource.data.status == 'in-progress')
                    && request.resource.data.courierId == request.auth.uid;

      // 2. Courier: Update status during the delivery process
      allow update: if isCourier()
                    && resource.data.courierId == request.auth.uid
                    && (
                      (request.resource.data.status == 'in-progress')
                      || (request.resource.data.status == 'finished')
                    );

      // --- Client Rules ---
      
      // A client can cancel (refuse) their own delivery if it's still pending
      allow update: if isAuth() 
                    && resource.data.clientId == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'refused'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'observations']);

      // Read rules for various roles
      allow get: if isAdmin() 
                 || (isAuth() && resource.data.clientId == request.auth.uid) 
                 || (isAuth() && resource.data.courierId == request.auth.uid);

      // Queries are allowed, but will be filtered by the 'get' rules above.
      allow list: if isAuth();
      
      allow delete: if false;
    }

    // NOTIFICATIONS
    match /notifications/{notificationId} {
      // Anyone authenticated can create a notification
      allow create: if isAuth();
      // User can only read/list their own.
      allow get, list, update: if isOwner(resource.data.userId);
      allow delete: if false;
    }

    // STATUS
    match /status/{statusId} {
      // Allow anyone to see if admin is online for better UX
      allow get: if true;
      allow write: if isAdmin();
      allow list, delete: if false;
    }

    // SETTINGS (Sensitive Info)
    match /settings/{settingId} {
      // Only admins can manage settings
      allow get, write: if isAdmin();
      allow list, delete: if false;
    }
  }
}
